# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # keep secret, server-only

# Your deployed site URL (no trailing slash). Use http://localhost:3000 for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SSLCommerz (get free sandbox credentials at https://developer.sslcommerz.com/registration/)
SSLCZ_STORE_ID=your_sandbox_store_id
SSLCZ_STORE_PASSWORD=your_sandbox_store_password
SSLCZ_IS_LIVE=false   # set to "true" only after SSLCommerz approves your live merchant account
